{
  "name": "niben-desktop",
  "productName": "niben",
  "version": "1.0.1",
  "description": "niben.no som app – alltid samme versjon som nettsiden",
  "main": "out/main.js",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist": "npm run build && electron-builder --mac --arm64 --win --x64",
    "dist:music": "npm run build && electron-builder --config out/music.builder.js --mac --arm64 && electron-builder --config out/music.builder.js --win --x64",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "build": {
    "appId": "no.niben.app",
    "productName": "niben",
    "artifactName": "niben-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "offline.html"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.lifestyle",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "niben"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "niben"
    },
    "electronVersion": "44.5.1+wvcus",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/"
    }
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v44.5.1+wvcus",
    "electron-builder": "^26.15.3",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
