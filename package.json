{
  "name": "niben",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.sw.json && tsc -p tsconfig.node.json && tsc -p desktop/tsconfig.json",
    "check:any": "! grep -rnE '(: |as |<|[|] )any\\b|any\\[\\]' src server vite.config.ts desktop/src --include=*.ts --include=*.vue",
    "check": "npm run typecheck && npm run check:any",
    "zip": "bash scripts/make-upload-zip.sh",
    "test:unit": "vitest run",
    "test:api": "bash tests/api/run.sh",
    "test:e2e": "bash tests/e2e/run.sh",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "d3-geo": "^3.1.1",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.14",
    "three": "^0.186.1",
    "three-conic-polygon-geometry": "^2.1.3",
    "three-geojson-geometry": "^2.1.1",
    "three-globe": "^2.45.3",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "bcryptjs": "^3.0.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
